# Environment variables for the AI Chatbot Platform

# --- LLM Configuration ---
# LLM_BASE_URL="http://141.98.210.149:15203/v1" # Uncomment and set if different from default in config.py
# LLM_MODEL_NAME="gpt-4o" # Uncomment and set if different from default in config.py
# LLM_API_KEY="YOUR_LLM_API_KEY" # IMPORTANT: Replace with your actual LLM API key
# LLM_TEMPERATURE="0.5" # Uncomment and set if different from default in config.py

# --- Embeddings Configuration ---
# EMBEDDINGS_MODEL="nomic-embed-text" # Uncomment and set if different from default in config.py
# OLLAMA_BASE_URL="http://localhost:11434" # Uncomment and set if your Ollama instance is not at the default location

# --- Database Configuration ---
# Use this for SQLite (default)
DATABASE_URL="sqlite:///./chat_platform.db"
# Example for PostgreSQL:
# DATABASE_URL="postgresql://youruser:yourpassword@localhost:5432/yourdatabase"

# --- RAG Uploads Directory ---
# RAG_UPLOAD_DIR="rag_uploads" # Uncomment and set if different from default in config.py
